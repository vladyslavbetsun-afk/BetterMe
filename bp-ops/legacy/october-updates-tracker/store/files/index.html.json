{
  "text": "<style>\n.ou { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n.ou-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.ou-take { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); margin: var(--cds-gap-xs) 0 0; max-width: 70ch; }\n.ou-cards { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }\n.ou-card, .ou-panel { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n.ou-card { display: grid; gap: var(--cds-gap-xs); align-content: start; }\n.ou-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.ou-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; min-height: 1.2em; }\n.ou-delta { font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.ou-up { color: var(--color-ok); } .ou-down { color: var(--color-bad); } .ou-flat { color: var(--color-fg-muted); }\n.ou-charts { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }\n.ou-panel h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.ou-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 var(--cds-gap-sm); }\n.ou-chart { position: relative; min-height: 180px; }\n.ou-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n.ou-tip .d { color: var(--cds-text-secondary); }\n.ou-tools { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); align-items: center; margin-bottom: var(--cds-gap-sm); }\n.ou-tools input { flex: 1 1 14rem; min-width: 0; font: inherit; font-size: var(--cds-font-size-body); padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); }\n.ou-tools button { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); cursor: pointer; }\n.ou-tools button[aria-pressed=\"true\"] { background: var(--color-panel); font-weight: var(--cds-font-weight-medium); }\n.ou-tablebox { max-height: 34rem; overflow: auto; }\n.ou-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.ou-table th { position: sticky; top: 0; background: var(--color-panel); text-align: right; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.ou-table th button { all: unset; cursor: pointer; }\n.ou-table th:first-child, .ou-table td:first-child { text-align: left; }\n.ou-table td { text-align: right; padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.ou-table td:first-child { white-space: normal; overflow-wrap: anywhere; min-width: 12rem; }\n.ou-table a { color: inherit; }\n.ou-chip { display: inline-block; margin-left: var(--cds-gap-xs); font-size: var(--cds-font-size-caption); color: var(--color-ok); }\n.ou-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); min-height: 180px; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.ou-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n[data-dash-source-state=empty] { color: transparent; }\n@media (max-width: 40rem) { .ou-hide-narrow { display: none; } }\n</style>\n\n<div class=\"ou\">\n  <header class=\"ou-head\" id=\"summary\">\n    <h1>October updates: traffic and AI visibility</h1>\n    <p class=\"ou-take dash-skeleton\" data-source=\"latest\">—</p>\n  </header>\n\n  <section class=\"ou-cards\" id=\"headline\" aria-label=\"Headline figures\">\n    <div class=\"ou-card\" id=\"card-traffic\">\n      <span class=\"ou-label\">Est. organic traffic / month (Ahrefs)</span>\n      <span class=\"ou-big dash-skeleton\" data-source=\"latest\" data-field=\"traffic\" data-row=\"0\">—</span>\n      <span class=\"ou-delta\" id=\"d-traffic_delta\"><span data-source=\"latest\" data-field=\"traffic_delta\" data-row=\"0\">—</span> vs baseline</span>\n    </div>\n    <div class=\"ou-card\" id=\"card-ai\">\n      <span class=\"ou-label\">AI citations, all platforms (Ahrefs)</span>\n      <span class=\"ou-big dash-skeleton\" data-source=\"latest\" data-field=\"ai_all\" data-row=\"0\">—</span>\n      <span class=\"ou-delta\" id=\"d-ai_delta\"><span data-source=\"latest\" data-field=\"ai_delta\" data-row=\"0\">—</span> vs baseline</span>\n    </div>\n    <div class=\"ou-card\" id=\"card-top3\">\n      <span class=\"ou-label\">Keywords in top 3</span>\n      <span class=\"ou-big dash-skeleton\" data-source=\"latest\" data-field=\"top3\" data-row=\"0\">—</span>\n      <span class=\"ou-delta\" id=\"d-top3_delta\"><span data-source=\"latest\" data-field=\"top3_delta\" data-row=\"0\">—</span> vs baseline</span>\n    </div>\n    <div class=\"ou-card\" id=\"card-updated\">\n      <span class=\"ou-label\">Pages updated (live \"Updated on\" in October)</span>\n      <span class=\"ou-big dash-skeleton\" data-source=\"latest\" data-field=\"updated_pages\" data-row=\"0\">—</span>\n      <span class=\"ou-delta ou-flat\">pages with an October 2026 byline</span>\n    </div>\n  </section>\n\n  <section class=\"ou-charts\" id=\"trends\">\n    <div class=\"ou-panel\" id=\"chart-traffic-card\">\n      <h2>Traffic by week</h2>\n      <p class=\"ou-note\">Sum of Ahrefs estimated monthly organic traffic for the 74 pages, taken each Monday.</p>\n      <div class=\"ou-chart dash-skeleton\" id=\"chart-traffic\" data-source=\"totals\"></div>\n    </div>\n    <div class=\"ou-panel\" id=\"chart-ai-card\">\n      <h2>AI citations by week</h2>\n      <p class=\"ou-note\">Citations across AI Overviews, AI Mode, ChatGPT, Perplexity, Gemini and Copilot.</p>\n      <div class=\"ou-chart dash-skeleton\" id=\"chart-ai\" data-source=\"totals\"></div>\n    </div>\n  </section>\n\n  <section class=\"ou-panel\" id=\"pages\">\n    <h2>Every page: baseline vs latest</h2>\n    <p class=\"ou-note\">Baseline is the first check (Oct 13, 2026). \"Updated\" means the live byline shows an October 2026 date.</p>\n    <div class=\"ou-tools\">\n      <input id=\"ou-search\" type=\"search\" placeholder=\"Search pages\" aria-label=\"Search pages\">\n      <button type=\"button\" id=\"ou-f-all\" aria-pressed=\"true\">All pages</button>\n      <button type=\"button\" id=\"ou-f-upd\" aria-pressed=\"false\">Updated only</button>\n    </div>\n    <div class=\"ou-tablebox\">\n      <table class=\"ou-table\" data-source=\"pages\" data-row-key=\"slug\">\n        <thead><tr>\n          <th data-field=\"slug\"><button data-sort=\"slug\">Page</button></th>\n          <th data-field=\"updated_on\"><button data-sort=\"updated_on\">Updated on</button></th>\n          <th data-field=\"traffic_base\" class=\"ou-hide-narrow\"><button data-sort=\"traffic_base\">Traffic, base</button></th>\n          <th data-field=\"traffic_now\"><button data-sort=\"traffic_now\">Traffic, now</button></th>\n          <th data-field=\"traffic_delta\"><button data-sort=\"traffic_delta\">Change</button></th>\n          <th data-field=\"ai_base\" class=\"ou-hide-narrow\"><button data-sort=\"ai_base\">AI cit., base</button></th>\n          <th data-field=\"ai_now\"><button data-sort=\"ai_now\">AI cit., now</button></th>\n          <th data-field=\"ai_delta\"><button data-sort=\"ai_delta\">Change</button></th>\n          <th data-field=\"top3_now\" class=\"ou-hide-narrow\"><button data-sort=\"top3_now\">Top-3 kw</button></th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n</div>\n\n<script>\ndash.calc('totals', {\n  title: 'Weekly totals',\n  description: 'Sums each weekly check across all 74 pages.',\n  inputs: ['weekly'],\n  fn: (weekly) => {\n    const by = {};\n    for (const r of weekly) {\n      const w = String(r.week).slice(0, 10);\n      const t = by[w] || (by[w] = { week: w, traffic: 0, ai_all: 0, top3: 0, keywords: 0, updated_pages: 0, pages: 0 });\n      t.traffic += Number(r.traffic) || 0;\n      t.ai_all += Number(r.ai_all) || 0;\n      t.top3 += Number(r.top3) || 0;\n      t.keywords += Number(r.keywords) || 0;\n      t.updated_pages += (r.updated === true || r.updated === 'true') ? 1 : 0;\n      t.pages += 1;\n    }\n    return Object.values(by).sort((a, b) => a.week < b.week ? -1 : 1);\n  },\n});\n\ndash.calc('latest', {\n  title: 'Latest week vs baseline',\n  description: 'The newest weekly totals and their change from the first check.',\n  inputs: ['totals'],\n  fn: (totals) => {\n    if (!totals.length) return [];\n    const base = totals[0], now = totals[totals.length - 1];\n    return [{\n      week: now.week, base_week: base.week, weeks: totals.length,\n      traffic: now.traffic, traffic_delta: now.traffic - base.traffic,\n      ai_all: now.ai_all, ai_delta: now.ai_all - base.ai_all,\n      top3: now.top3, top3_delta: now.top3 - base.top3,\n      updated_pages: now.updated_pages, pages: now.pages,\n    }];\n  },\n});\n\ndash.calc('pages', {\n  title: 'Per page: baseline vs latest',\n  description: 'Each page at the first check and at the newest check, with the change.',\n  inputs: ['weekly'],\n  fn: (weekly) => {\n    const weeks = [...new Set(weekly.map((r) => String(r.week).slice(0, 10)))].sort();\n    if (!weeks.length) return [];\n    const first = weeks[0], last = weeks[weeks.length - 1];\n    const base = {}, now = {};\n    for (const r of weekly) {\n      const w = String(r.week).slice(0, 10);\n      if (w === first) base[r.slug] = r;\n      if (w === last) now[r.slug] = r;\n    }\n    return Object.keys(now).map((slug) => {\n      const n = now[slug], b = base[slug] || n;\n      return {\n        slug, url: n.url, updated_on: n.updated_on, updated: n.updated === true || n.updated === 'true',\n        traffic_base: Number(b.traffic) || 0, traffic_now: Number(n.traffic) || 0,\n        traffic_delta: (Number(n.traffic) || 0) - (Number(b.traffic) || 0),\n        ai_base: Number(b.ai_all) || 0, ai_now: Number(n.ai_all) || 0,\n        ai_delta: (Number(n.ai_all) || 0) - (Number(b.ai_all) || 0),\n        top3_now: Number(n.top3) || 0,\n      };\n    });\n  },\n});\n\n(() => {\n  const fmt = d3.format(',');\n  const signed = (v) => (v > 0 ? '+' : v < 0 ? '-' : '') + fmt(Math.abs(v));\n  const dayFmt = d3.utcFormat('%b %-d');\n  const dateOf = (s) => new Date(String(s).slice(0, 10) + 'T00:00:00Z');\n  const state = { q: '', onlyUpdated: false, sort: 'traffic_now', dir: -1 };\n\n  const setDelta = (field, v) => {\n    const box = document.getElementById('d-' + field);\n    box.classList.remove('ou-up', 'ou-down', 'ou-flat');\n    box.classList.add(v > 0 ? 'ou-up' : v < 0 ? 'ou-down' : 'ou-flat');\n    box.querySelector('[data-field=\"' + field + '\"]').textContent = signed(v);\n  };\n\n  const fail = (el) => { el.replaceChildren(); const d = document.createElement('div'); d.className = 'ou-fail'; d.textContent = 'Failed to load'; el.appendChild(d); };\n\n  function drawLine(el, rows, key, color, label) {\n    el.replaceChildren();\n    const W = Math.max(el.clientWidth, 260), H = 180;\n    const pts = rows.map((r) => ({ d: dateOf(r.week), v: r[key] }));\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', label);\n    const maxV = d3.max(pts, (p) => p.v) || 1;\n    const y = d3.scaleLinear([0, maxV * 1.15], [H - 24, 10]).nice();\n    const yTicks = y.ticks(4);\n    const probe = svg.append('text').attr('font-size', 11).text(fmt(d3.max(yTicks)));\n    const left = Math.ceil(probe.node().getComputedTextLength()) + 10; probe.remove();\n    const dates = pts.map((p) => p.d);\n    const x0 = d3.min(dates), x1 = d3.max(dates);\n    const x = d3.scaleUtc(x0 === x1 || +x0 === +x1 ? [d3.utcDay.offset(x0, -3), d3.utcDay.offset(x0, 3)] : [x0, x1], [left + 6, W - 16]);\n    svg.append('g').selectAll('line').data(yTicks).join('line')\n      .attr('x1', left).attr('x2', W - 8).attr('y1', (t) => y(t)).attr('y2', (t) => y(t))\n      .attr('stroke', 'var(--cds-chart-grid)').attr('stroke-width', 1);\n    svg.append('g').selectAll('text').data(yTicks).join('text')\n      .attr('x', left - 6).attr('y', (t) => y(t)).attr('dy', '0.32em').attr('text-anchor', 'end')\n      .attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text((t) => fmt(t));\n    const xt = pts.length <= 6 ? dates : x.ticks(5);\n    svg.append('g').selectAll('text').data(xt).join('text')\n      .attr('x', (d) => x(d)).attr('y', H - 6).attr('text-anchor', 'middle')\n      .attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text((d) => dayFmt(d));\n    if (pts.length > 1) {\n      svg.append('path').datum(pts).attr('fill', 'none').attr('stroke', color).attr('stroke-width', 2)\n        .attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round')\n        .attr('d', d3.line((p) => x(p.d), (p) => y(p.v)));\n    }\n    const tip = document.createElement('div'); tip.className = 'ou-tip'; tip.hidden = true; el.appendChild(tip);\n    svg.append('g').selectAll('circle').data(pts).join('circle')\n      .attr('cx', (p) => x(p.d)).attr('cy', (p) => y(p.v)).attr('r', 4).attr('fill', color)\n      .on('mouseenter', (ev, p) => {\n        tip.replaceChildren();\n        const a = document.createElement('div'); a.className = 'd'; a.textContent = 'Week of ' + dayFmt(p.d);\n        const b = document.createElement('div'); b.textContent = label + ': ' + fmt(p.v);\n        tip.append(a, b); tip.hidden = false;\n        const px = x(p.d) / W * el.clientWidth;\n        tip.style.left = Math.min(Math.max(px - tip.offsetWidth / 2, 0), el.clientWidth - tip.offsetWidth) + 'px';\n        tip.style.top = Math.max(y(p.v) / H * el.clientHeight - tip.offsetHeight - 10, 0) + 'px';\n      })\n      .on('mouseleave', () => { tip.hidden = true; });\n    const lastP = pts[pts.length - 1];\n    if (pts.length === 1) {\n      svg.append('text').attr('x', x(lastP.d)).attr('y', y(lastP.v) - 10).attr('text-anchor', 'middle')\n        .attr('font-size', 11).attr('fill', 'var(--color-fg-muted)').text('Trend starts after the next weekly check');\n    }\n  }\n\n  function drawTable(rows) {\n    const tbody = document.querySelector('.ou-table tbody');\n    const q = state.q.toLowerCase();\n    let list = rows.filter((r) => (!state.onlyUpdated || r.updated) && (!q || r.slug.toLowerCase().includes(q)));\n    const k = state.sort;\n    list = list.slice().sort((a, b) => {\n      const va = a[k], vb = b[k];\n      if (typeof va === 'number' && typeof vb === 'number') return (va - vb) * state.dir;\n      return String(va).localeCompare(String(vb)) * state.dir;\n    });\n    document.querySelectorAll('.ou-table th').forEach((th) => {\n      const f = th.querySelector('button').dataset.sort;\n      th.setAttribute('aria-sort', f === k ? (state.dir > 0 ? 'ascending' : 'descending') : 'none');\n    });\n    tbody.replaceChildren(...list.map((r) => {\n      const tr = document.createElement('tr');\n      const td0 = document.createElement('td');\n      const a = document.createElement('a'); a.href = r.url; a.target = '_blank'; a.rel = 'noopener'; a.textContent = r.slug;\n      td0.appendChild(a);\n      if (r.updated) { const c = document.createElement('span'); c.className = 'ou-chip'; c.textContent = '● updated'; td0.appendChild(c); }\n      const cells = [\n        r.updated_on ? dayFmt(dateOf(r.updated_on)) + ', ' + String(r.updated_on).slice(0, 4) : '',\n        fmt(r.traffic_base), fmt(r.traffic_now), signed(r.traffic_delta),\n        fmt(r.ai_base), fmt(r.ai_now), signed(r.ai_delta), fmt(r.top3_now),\n      ];\n      const hide = [false, true, false, false, true, false, false, true];\n      const tds = cells.map((c, i) => {\n        const td = document.createElement('td'); td.textContent = c;\n        if (hide[i]) td.className = 'ou-hide-narrow';\n        if (i === 3 || i === 6) { const v = i === 3 ? r.traffic_delta : r.ai_delta; td.classList.add(v > 0 ? 'ou-up' : v < 0 ? 'ou-down' : 'ou-flat'); }\n        return td;\n      });\n      tr.append(td0, ...tds);\n      return tr;\n    }));\n  }\n\n  let lastPages = [];\n  document.getElementById('ou-search').addEventListener('input', (e) => { state.q = e.target.value; drawTable(lastPages); });\n  const fAll = document.getElementById('ou-f-all'), fUpd = document.getElementById('ou-f-upd');\n  fAll.addEventListener('click', () => { state.onlyUpdated = false; fAll.setAttribute('aria-pressed', 'true'); fUpd.setAttribute('aria-pressed', 'false'); drawTable(lastPages); });\n  fUpd.addEventListener('click', () => { state.onlyUpdated = true; fUpd.setAttribute('aria-pressed', 'true'); fAll.setAttribute('aria-pressed', 'false'); drawTable(lastPages); });\n  document.querySelectorAll('.ou-table th button').forEach((b) => b.addEventListener('click', () => {\n    const f = b.dataset.sort;\n    if (state.sort === f) state.dir = -state.dir; else { state.sort = f; state.dir = f === 'slug' ? 1 : -1; }\n    drawTable(lastPages);\n  }));\n\n  dash.onData(() => {\n    const L = dash.data('latest'), T = dash.data('totals'), P = dash.data('pages');\n    const take = document.querySelector('.ou-take');\n    const cards = document.querySelectorAll('#headline [data-source=\"latest\"]');\n    if (L.status === 'ok' && L.data.length) {\n      const l = L.data[0];\n      document.querySelectorAll('.dash-skeleton[data-source=\"latest\"]').forEach((e) => e.classList.remove('dash-skeleton'));\n      document.querySelector('#headline [data-field=\"traffic\"]').textContent = fmt(l.traffic);\n      document.querySelector('#headline [data-field=\"ai_all\"]').textContent = fmt(l.ai_all);\n      document.querySelector('#headline [data-field=\"top3\"]').textContent = fmt(l.top3);\n      document.querySelector('#headline [data-field=\"updated_pages\"]').textContent = fmt(l.updated_pages);\n      setDelta('traffic_delta', l.traffic_delta);\n      setDelta('ai_delta', l.ai_delta);\n      setDelta('top3_delta', l.top3_delta);\n      if (l.weeks < 2) {\n        take.textContent = 'Baseline taken ' + dayFmt(dateOf(l.base_week)) + '. Changes appear after the first weekly check; Ahrefs usually needs 2–4 weeks to reflect an update.';\n      } else {\n        const dir = (v) => v > 0 ? 'up' : v < 0 ? 'down' : 'flat';\n        take.textContent = 'Week of ' + dayFmt(dateOf(l.week)) + ': traffic is ' + dir(l.traffic_delta) + ' ' + fmt(Math.abs(l.traffic_delta)) + ' and AI citations are ' + dir(l.ai_delta) + ' ' + fmt(Math.abs(l.ai_delta)) + ' since the ' + dayFmt(dateOf(l.base_week)) + ' baseline, with ' + fmt(l.updated_pages) + ' pages updated.';\n      }\n    } else if (L.status === 'error' || T.status === 'error') {\n      take.classList.remove('dash-skeleton'); take.textContent = '';\n      cards.forEach((e) => { e.classList.remove('dash-skeleton'); e.textContent = '—'; });\n    }\n\n    const ct = document.getElementById('chart-traffic'), ca = document.getElementById('chart-ai');\n    if (T.status === 'ok' && T.data.length) {\n      ct.classList.remove('dash-skeleton'); ca.classList.remove('dash-skeleton');\n      drawLine(ct, T.data, 'traffic', dash.colors[0], 'Est. traffic');\n      drawLine(ca, T.data, 'ai_all', dash.colors[1], 'AI citations');\n    } else if (T.status === 'error') {\n      ct.classList.remove('dash-skeleton'); ca.classList.remove('dash-skeleton'); fail(ct); fail(ca);\n    } else { ct.replaceChildren(); ca.replaceChildren(); }\n\n    if (P.status === 'ok') { lastPages = P.data; drawTable(lastPages); }\n    else { lastPages = []; drawTable([]); }\n  });\n})();\n</script>\n"
}
